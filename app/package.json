{
  "name": "magi-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "shell/main.mjs",
  "description": "MAGI operator UI — Vite SPA in the browser, Electron on the desktop.",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"electron .\"",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.cjs",
    "build:desktop": "npm run build && electron-builder",
    "preview": "vite preview",
    "lint": "node scripts/i18n-lint.cjs",
    "lint:i18n": "node scripts/i18n-lint.cjs",
    "test": "node --test tests/app-store.test.mjs"
  },
  "build": {
    "appId": "ai.magi.app",
    "productName": "MAGI",
    "files": [
      "dist/**",
      "shell/**",
      "core/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
