# =============================================================================
# MAGI — env schema. Copy to `.env` and edit. NEVER commit `.env`.
#
# `docker-compose.yml` loads this file via `env_file: ../.env`.
# Variables are used for compose interpolation AND passed into
# the container.  The container-internal workspace is always at
# ``/workspace`` (hardcoded) — MAGI_WORKSPACE_DIR is only the
# host-side bind-mount source.
# =============================================================================

# Absolute path to the host-side MAGI workspace directory.
# Each MAGI node gets its own subdirectory:
#   Adam : ${MAGI_WORKSPACE_DIR}/Adam     → /workspace inside container
#   EVE  : ${MAGI_WORKSPACE_DIR}/eve-<id> → /workspace inside container
MAGI_WORKSPACE_DIR=/path/to/your/workspace

# Host timezone, passed into the container as TZ.
HOST_TZ=UTC
