#!/usr/bin/env bash
# Openclaw-style MAGI CLI wrapper for the single-machine local deployment.
#
# This is a thin shell front-end over the `magi` Python console script
# that ships with the package. It only does two things:
#
#   1. Resolve the data root into the OS-specific openclaw path so
#      `magi local start` always finds the right on-disk layout.
#   2. Forward all arguments to the underlying `magi` binary so the
#      Python implementation remains the single source of truth.
#
# Operators who prefer the raw `magi` command can keep using it; this
# wrapper only adds the `MAGI_DATA_ROOT` glue so a fresh terminal
# `magi local start` does the right thing with no extra flags.
#
# Usage:
#   deploy/local/magi local start
#   deploy/local/magi local install-service
#   deploy/local/magi --help
set -euo pipefail

resolve_data_root() {
  if [ -n "${MAGI_DATA_ROOT:-}" ]; then
    printf '%s\n' "$MAGI_DATA_ROOT"
    return
  fi
  case "$(uname -s)" in
    Darwin)               printf '%s\n' "$HOME/Documents/.magi" ;;
    MINGW*|MSYS*|CYGWIN*) printf '%s\n' "$USERPROFILE/Documents/.magi" ;;
    *)                    printf '%s\n' "$HOME/.magi" ;;
  esac
}

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if command -v magi >/dev/null 2>&1; then
  MAGI_BIN="$(command -v magi)"
elif [ -x "$SCRIPT_DIR/../../.venv/bin/magi" ]; then
  MAGI_BIN="$SCRIPT_DIR/../../.venv/bin/magi"
else
  echo "[magi] 'magi' is not on PATH. Run deploy/local/install.sh first." >&2
  exit 127
fi

export MAGI_DATA_ROOT="$(resolve_data_root)"
# The Local Profile's first MAGIS is always Genesis (magis_id=1, slug="genesis"),
# matching the K8s convention ``MAGIS/<magis_id>-<slug>/magis.db``. Exporting
# it as ``MAGIS_DATABASE_URL`` lets any subprocess the launcher spawns
# (Adam runtime, WebUI control plane) resolve the public MAGIS schema via
# the same env-var path the K8s Profile uses. ``magi local start`` also
# injects the engine in-process, but the subprocesses don't inherit that
# injection — they read this env var instead.
export MAGIS_DATABASE_URL="${MAGIS_DATABASE_URL:-sqlite:///$MAGI_DATA_ROOT/MAGIS/1-genesis/magis.db}"
# Local Profile launches runtimes via the in-process backend, not via
# the Kubernetes operator. The factory defaults to ``kubernetes``; the
# Local wrapper overrides that so ``magi local start`` boots the Adam
# without needing cluster credentials.
export MAGI_BACKEND="${MAGI_BACKEND:-local_process}"
exec "$MAGI_BIN" "$@"
