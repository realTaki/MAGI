#!/usr/bin/env bash
# Openclaw-style MAGI CLI wrapper for the single-machine local deployment.
#
# This is a thin shell front-end over the `magi` Python console script
# that ships with the package. It only does two things:
#
#   1. Resolve the data root into the OS-specific openclaw path so
#      `magi local start` always finds the right on-disk layout.
#   2. Forward all arguments to the underlying `magi` binary so the
#      Python implementation remains the single source of truth.
#
# Each MAGI is an independent OS process. ``magi local start`` bootstraps
# once (first run) then becomes the MAGI runtime in the current process.
# ``magi local install-service`` registers one systemd unit per MAGI.
#
# Usage:
#   deploy/local/magi local start        # run first MAGI (eva-000)
#   deploy/local/magi local start --name eva-001  # run a specific MAGI
#   deploy/local/magi local install-service       # systemd units for all
#   deploy/local/magi --help
set -euo pipefail

resolve_data_root() {
  if [ -n "${MAGI_DATA_ROOT:-}" ]; then
    printf '%s\n' "$MAGI_DATA_ROOT"
    return
  fi
  case "$(uname -s)" in
    Darwin)               printf '%s\n' "$HOME/Documents/.magi" ;;
    MINGW*|MSYS*|CYGWIN*) printf '%s\n' "$USERPROFILE/Documents/.magi" ;;
    *)                    printf '%s\n' "$HOME/.magi" ;;
  esac
}

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if command -v magi >/dev/null 2>&1; then
  MAGI_BIN="$(command -v magi)"
elif [ -x "$SCRIPT_DIR/../../.venv/bin/magi" ]; then
  MAGI_BIN="$SCRIPT_DIR/../../.venv/bin/magi"
else
  echo "[magi] 'magi' is not on PATH. Run deploy/local/install.sh first." >&2
  exit 127
fi

export MAGI_DATA_ROOT="$(resolve_data_root)"
# The Local Profile's first MAGIS is always Genesis (magis_id=1, slug="genesis"),
# matching the K8s convention ``MAGIS/<magis_id>-<slug>/magis.db``.
export MAGIS_DATABASE_URL="${MAGIS_DATABASE_URL:-sqlite:///$MAGI_DATA_ROOT/MAGIS/genesis-01/magis.db}"
exec "$MAGI_BIN" "$@"
