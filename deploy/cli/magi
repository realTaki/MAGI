#!/usr/bin/env bash
# Thin local launcher for the explicit MAGI CLI.
set -euo pipefail

resolve_data_root() {
  if [ -n "${HOST_WORKSPACE_DIR:-}" ]; then
    printf '%s\n' "$HOST_WORKSPACE_DIR"
    return
  fi
  case "$(uname -s)" in
    Darwin) printf '%s\n' "$HOME/Documents/.magi" ;;
    MINGW*|MSYS*|CYGWIN*) printf '%s\n' "$USERPROFILE/Documents/.magi" ;;
    *) printf '%s\n' "$HOME/.magi" ;;
  esac
}

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if command -v magi >/dev/null 2>&1; then
  MAGI_BIN="$(command -v magi)"
elif [ -x "$SCRIPT_DIR/../../.venv/bin/magi" ]; then
  MAGI_BIN="$SCRIPT_DIR/../../.venv/bin/magi"
else
  echo "[magi] magi is not installed; run deploy/cli/install.sh first." >&2
  exit 127
fi

export HOST_WORKSPACE_DIR="$(resolve_data_root)"
exec "$MAGI_BIN" "$@"
