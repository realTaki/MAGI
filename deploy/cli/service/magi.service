[Unit]
Description=MAGI CLI runtime (openclaw-style single-machine)
Documentation=https://github.com/realTaki/MAGI
After=network-online.target
Wants=network-online.target

[Service]
# ``Type=notify`` so the runtime can ack with ``sd_notify(READY=1)`` and
# arm the watchdog with ``WATCHDOG=1`` pings.  Without this, systemd
# only learns about a crash after the process exits — by which time a
# silent hang (e.g. uvicorn stuck in a reload loop) has already lost
# the user-visible runtime port.
Type=notify
NotifyAccess=main
# __MAGI_BIN__ is replaced with the resolved magi executable at
# install time. Provision first with `magi init`; the service keeps the
# Runtime in the foreground, so systemd owns restart and shutdown.
ExecStart=__MAGI_BIN__ node run --foreground --name eva-000
ExecStop=__MAGI_BIN__ node stop --name eva-000
Restart=on-failure
RestartSec=5
# systemd kills the service if it misses two pings in a row.  The
# runtime pings every 15 s (half the window); a 30 s hang is enough
# for the supervisor to be replaced by a fresh process.
WatchdogSec=30s
# The launcher writes to /home/<user>/.magi (Linux) — limit blast
# radius to the user account.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
