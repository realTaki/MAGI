[Unit]
Description=MAGI CLI runtime (openclaw-style single-machine)
Documentation=https://github.com/realTaki/MAGI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __MAGI_BIN__ is replaced with the resolved magi executable at
# install time. Provision first with `magi init`; the service keeps the
# Runtime in the foreground, so systemd owns restart and shutdown.
ExecStart=__MAGI_BIN__ node run --foreground --name eva-000
ExecStop=__MAGI_BIN__ node stop --name eva-000
Restart=on-failure
RestartSec=5
# The launcher writes to /home/<user>/.magi (Linux) — limit blast
# radius to the user account.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
