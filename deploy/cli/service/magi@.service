# Template for a hand-written systemd Runtime unit.  Provision with
# ``magi init`` and ``magi node create`` first; systemd only runs the
# already-provisioned Runtime in the foreground.
#
# Each MAGI gets its own unit (magi-adam.service, magi-eva-00.service, …).
# ``systemctl --user status magi-*.service`` lists them all.
[Unit]
Description=MAGI runtime — __SLUG__ (magi_id=__MAGI_ID__)
Documentation=https://github.com/realTaki/MAGI
After=network-online.target
Wants=network-online.target

[Service]
# ``Type=notify`` so the runtime acks with ``sd_notify(READY=1)`` and
# arms the watchdog.  WatchdogSec=30s pairs with a 15 s ping inside
# ``run_magi``; one missed ping is tolerable, two trigger a SIGABRT.
Type=notify
NotifyAccess=main
Environment=HOST_WORKSPACE_DIR=__DATA_ROOT__
Environment=MAGI_NAME=__SLUG__
ExecStart=__MAGI_BIN__ node run --foreground --name __SLUG__
Restart=on-failure
RestartSec=5
WatchdogSec=30s
# Allow writing only into the MAGI data root.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__DATA_ROOT__
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
