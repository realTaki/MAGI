# Example systemd user unit for one MAGI runtime.
#
# Provision with ``magi init`` before enabling this unit.  This file is a
# reference for operators who prefer a hand-written foreground Runtime unit.
#
# Each MAGI is an independent process — one crashes, the others keep running.
# ``systemctl --user status magi-*.service`` lists them all.
[Unit]
Description=MAGI runtime — eva-000 (magi_id=1)
Documentation=https://github.com/realTaki/MAGI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=MAGI_DATA_ROOT=%h/.magi
Environment=MAGI_NAME=eva-000
ExecStart=magi node run --foreground --name eva-000
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.magi
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
