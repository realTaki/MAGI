# Example systemd user unit for one MAGI runtime.
#
# Generated by ``magi local install-service``, which creates one unit per
# MAGIC slot (magi-eva-000.service, magi-eva-001.service, …).  This file is
# a reference for operators who prefer hand-written units.
#
# Each MAGI is an independent process — one crashes, the others keep running.
# ``systemctl --user status magi-*.service`` lists them all.
[Unit]
Description=MAGI runtime — eva-000 (magic_id=1)
Documentation=https://github.com/realTaki/MAGI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=MAGI_DATA_ROOT=%h/.magi
Environment=MAGI_RUNTIME_ID=1
Environment=MAGI_NAME=eva-000
Environment=MAGI_PORT=42069
Environment=MAGIS_DATABASE_URL=sqlite:///%h/.magi/MAGIS/genesis-01/magis.db
ExecStart=magi runtime --host 127.0.0.1 --port 42069
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.magi
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
