# syntax=docker/dockerfile:1.7
# MAGI dev image — used only by the single-node k8s dev mode under
# deploy/k8s-dev/ (kind-only). Production uses the regular `Dockerfile`
# (no node, web/dist baked in, single `magi` process).
#
# The dev image carries BOTH the Python runtime (so `magi` can run) and
# the Node toolchain (so `vite dev` can serve the SPA with HMR). At
# container start it spawns vite as a background process and `exec`s
# `magi` as PID 1, so the container's lifecycle is tied to `magi`
# (vite crashing doesn't kill the container; magi crashing does, and
# the kubelet restarts the whole Pod).

FROM python:3.12-slim-bookworm

# Node 20 from NodeSource (bookworm doesn't ship a recent enough node
# for vite 6). Cleanup apt lists in the same layer to keep the image
# small.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# uv for Python deps (matches what the prod Dockerfile uses).
COPY --from=ghcr.io/astral-sh/uv:0.11.8 /uv /uvx /usr/local/bin/

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    # ``/opt/venv/bin`` is where uv installs the ``magi`` console script
    # declared in pyproject.toml. Prepending it to PATH means the
    # entrypoint's ``exec magi`` resolves to the venv binary, not the
    # base image's ``/usr/bin/magi`` (which doesn't exist).
    PATH="/opt/venv/bin:/usr/local/bin:/usr/bin:/bin" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
# Install Python deps (magi) from pyproject + uv.lock. We still do this
# so the venv has a baseline magi install — the kind hostPath mount of
# the checkout replaces it at runtime via PYTHONPATH.
COPY pyproject.toml uv.lock* README.md alembic.ini ./
COPY magi ./magi
RUN uv sync --frozen --no-dev --extra adam --extra eva

# Install web deps alongside the baked-in source. At runtime the source
# tree is replaced by a read-only bind mount at the same path, while a
# writable emptyDir is mounted at `/app/magi/WebUI/node_modules` so Vite
# can keep its cache there.
RUN cd /app/magi/WebUI && npm ci --no-audit --no-fund \
    && touch node_modules/.package-lock.json

# /workspace remains the agent's persistent workspace. Runtime source is
# deliberately kept under /app/magi instead, outside the agent workspace.
WORKDIR /workspace
RUN mkdir -p /workspace/memories

ENV MAGI_RELOAD=1

EXPOSE 42069

# No ENTRYPOINT / CMD here on purpose. The dev entrypoint script
# (start vite in background + exec magi) is bind-mounted from the
# host at /usr/local/bin/entrypoint.sh via
# docker-compose/docker-compose.dev.yml, so editing it doesn't
# require an image rebuild. With nothing below, the image's CMD
# is whatever the base python:3.12-slim
# sets by default — which we override to ``["magi"]`` here:
CMD ["magi"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD magi --check >/dev/null || exit 1
