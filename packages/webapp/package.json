{
  "name": "@magi/webapp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MAGI runtime package: the operator webapp worker.",
  "exports": {
    ".": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./*": {
      "types": "./dist/*",
      "default": "./dist/*"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@magi/bus": "*",
    "@magi/runtime": "*"
  }
}
