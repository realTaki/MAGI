{
  "name": "@magi/launcher",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MAGI launcher: bootstrap utilities and worker lifecycle supervision.",
  "exports": {
    ".": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./*": {
      "types": "./dist/*",
      "default": "./dist/*"
    },
    "./package.json": "./package.json",
    "./runtime/*": {
      "types": "./dist/runtime/*",
      "default": "./dist/runtime/*"
    },
    "./composition": {
      "types": "./dist/composition/index.d.ts",
      "default": "./dist/composition/index.js"
    },
    "./composition/*": {
      "types": "./dist/composition/*",
      "default": "./dist/composition/*"
    }
  },
  "scripts": {
    "build": "tsc -b composition"
  },
  "dependencies": {
    "@magi/bus": "*",
    "@magi/agent": "*",
    "@magi/providers": "*",
    "@magi/built-in-tools": "*",
    "@magi/contacts": "*",
    "@magi/memory": "*",
    "@magi/mcp": "*",
    "@magi/skills": "*",
    "@magi/channel-tasks": "*",
    "@magi/channel-telegram": "*",
    "@magi/webapp": "*",
    "@magi/channel-a2a": "*",
    "@magi/subconscious": "*",
    "@magi/action-items": "*"
  }
}
