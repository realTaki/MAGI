{
  "name": "@magi/dm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent Cordis plugin for durable local Bot DMs and non-waking main-Session notifications.",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "client.js", "dm-host.js", "dm-plugin.js", "dm-rpc.js", "dm-store.js", "dm-tool.js", "dm-user.js", "locale/*.json", "icon.svg", "README.md"],
  "scripts": { "test": "node --test test/*.test.js" },
  "peerDependencies": { "@deepseek-ai/dsh-tools": "*" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-tools": { "optional": true } },
  "dsh": { "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-chat"] } }
}
