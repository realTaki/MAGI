{
  "name": "@magi/bus",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MAGI runtime package: bus.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*",
      "default": "./dist/*"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "db:generate": "drizzle-kit generate --config=drizzle/memories.config.ts && drizzle-kit generate --config=drizzle/logs.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.11"
  }
}
