{
  "name": "@magi/bus",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MAGI runtime package: bus.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*",
      "default": "./dist/*"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "db:generate": "drizzle-kit generate --config=drizzle/books.config.ts && drizzle-kit generate --config=drizzle/jobs.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "@magi/launcher": "*"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
