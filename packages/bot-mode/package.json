{
  "name": "@magi/bot-mode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared parent and child Bot composition and persistent main-session lifecycle.",
  "exports": {
    ".": "./index.js",
    "./parent": "./parent.js",
    "./main-session": "./main-session.js",
    "./parent-main-session": "./parent-main-session.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["*.js", "README.md", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "scripts": { "test": "node --test test/*.test.js" },
  "engines": { "node": ">=24.0.0" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
