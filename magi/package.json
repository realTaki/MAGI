{
  "name": "magi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config=bus/drizzle.config.ts && drizzle-kit generate --config=bus/drizzle.logs.config.ts",
    "start": "bun magi.ts",
    "test": "bun run build && bun test test/*.test.ts"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.3",
    "@types/node": "24.13.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@modelcontextprotocol/client": "2.1.0",
    "drizzle-orm": "^0.45.3"
  }
}
