{
  "name": "magi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "protobufjs": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config=bus/drizzle.config.ts && drizzle-kit generate --config=bus/drizzle.logs.config.ts",
    "start": "node dist/magi.js",
    "test": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.13.6",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@chat-adapter/state-memory": "^4.41.0",
    "@chat-adapter/telegram": "^4.41.0",
    "@earendil-works/pi-ai": "0.87.1",
    "@modelcontextprotocol/client": "2.1.0",
    "better-sqlite3": "^13.0.3",
    "chat": "^4.41.0",
    "drizzle-orm": "^0.45.3",
    "ws": "^8.18.3"
  }
}
