{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["magi.ts", "bus/**/*.ts", "agent/**/*.ts", "providers/**/*.ts", "tools/**/*.ts", "channels/**/*.ts", "test/**/*.ts"]
}
