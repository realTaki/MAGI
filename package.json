{
  "name": "magi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MAGI DSH plugins: independent EVA nodes and native Desktop session navigation.",
  "workspaces": [
    "apps/eva",
    "apps/magi-shell",
    "packages/dm",
    "packages/memory",
    "packages/bot-mode",
    "packages/subconscious"
  ],
  "scripts": {
    "test": "node scripts/check-dsh.mjs && node scripts/test.mjs",
    "verify": "npm test",
    "pack:dsh": "node scripts/pack-dsh.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "test:portable": "node scripts/check-dsh.mjs && node scripts/test.mjs --portable"
  },
  "allowScripts": {
    "node": true
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "node": "24.21.0",
    "semver": "7.8.5"
  }
}
