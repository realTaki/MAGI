{
  "name": "magi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MAGI DSH plugins: independent EVA nodes and native Desktop session navigation.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node scripts/check-dsh.mjs && node scripts/test.mjs",
    "verify": "npm test",
    "db:generate": "npm run db:generate --workspace @magi/bus",
    "test:portable": "node scripts/check-dsh.mjs && node scripts/test.mjs --portable",
    "test:legacy": "tsc -b && npm run check:bootstrap --workspace @magi/shell && node scripts/test-legacy.mjs",
    "verify:legacy": "node scripts/verify.mjs"
  },
  "allowScripts": {
    "dugite": true,
    "electron-winstaller": true,
    "esbuild": true,
    "node": true,
    "protobufjs": true
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
