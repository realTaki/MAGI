{
  "name": "eva",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "The eva launcher. It starts one child process and does not run a BUS.",
  "exports": {
    ".": {
      "types": "./dist/eva.d.ts",
      "default": "./dist/eva.js"
    },
    "./*": {
      "types": "./dist/*",
      "default": "./dist/*"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node eva.mjs"
  },
  "dependencies": {
    "@magi/bus": "*",
    "@magi/launcher": "*",
    "@magi/agent": "*",
    "@magi/providers": "*",
    "@magi/built-in-tools": "*",
    "@magi/contacts": "*",
    "@magi/memory": "*",
    "@magi/mcp": "*",
    "@magi/skills": "*",
    "@magi/channel-tasks": "*",
    "@magi/channel-telegram": "*",
    "@magi/subconscious": "*",
    "@magi/action-items": "*"
  }
}
