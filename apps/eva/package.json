{
  "name": "@local/eva",
  "version": "0.6.15",
  "private": true,
  "type": "module",
  "description": "Manage desktop-free DSH nodes with profile, state, and workspace under one persistent home per handle.",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "runtime.js", "runner.js", "child.js", "credentials.js", "client.js", "view.js", "main-session.js", "relocate-workspace.js", "migrate-layout.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "scripts": { "test": "node --test test/*.test.js" },
  "peerDependencies": { "@deepseek-ai/dsh-tools": "*" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-tools": { "optional": true } },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-workspace"] } }
}
