{
  "name": "@magi/asp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MAGI ASP process: BUS manager and asp-server worker.",
  "exports": {
    ".": {
      "types": "./dist/asp.d.ts",
      "default": "./dist/asp.js"
    },
    "./*": {
      "types": "./dist/*",
      "default": "./dist/*"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/asp.js",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@magi/bus": "*",
    "@magi/asp-server": "*",
    "@magi/manager": "*",
    "@magi/agent": "*",
    "@magi/providers": "*",
    "@magi/built-in-tools": "*",
    "@magi/contacts": "*",
    "@magi/memory": "*",
    "@magi/skills": "*",
    "@magi/channel-asp": "*"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2",
    "ws": "^8.18.3"
  }
}
