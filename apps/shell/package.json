{
  "name": "@magi/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "description": "MAGI Electron shell and operator process.",
  "allowScripts": {
    "dugite": true,
    "electron": true,
    "electron-winstaller": true
  },
  "scripts": {
    "dev": "electron .",
    "dev:ui": "vite --config web/vite.config.ts",
    "build": "node scripts/build.mjs",
    "build:ui": "tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.config.ts && node scripts/postbuild.ts && tsc -b",
    "build:process": "tsc -b",
    "start": "node ../eva/eva.mjs --role shell",
    "lint": "node scripts/i18n-lint.ts",
    "lint:i18n": "node scripts/i18n-lint.ts",
    "test": "npm run check:bootstrap && node --test test/*.test.mjs test/*.test.ts",
    "check:bootstrap": "tsc --noEmit -p tsconfig.bootstrap.json"
  },
  "build": {
    "appId": "ai.magi.app",
    "productName": "MAGI",
    "executableName": "MAGI",
    "files": [
      "main.mjs",
      "source-checkout.mjs",
      "interface.mjs",
      "process.mjs",
      "process-owner.mjs",
      "profile-layout.mjs",
      "clone.mjs",
      "installation.mjs",
      "app-spec.mjs",
      "dependency-state.mjs",
      "runtime-environment.mjs",
      "preload.cjs",
      "shell-path.mjs",
      "update-script.mjs",
      "boot/**",
      "package.json",
      "desktop-update.mjs",
      "repository-origin.mjs",
      "build-origin.json"
    ],
    "asarUnpack": [
      "node_modules/dugite/git/**"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "app": ".",
      "output": "release"
    },
    "electronVersion": "44.4.5",
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "publish": null,
    "appImage": {
      "executableArgs": []
    },
    "beforePack": "scripts/before-pack.mjs"
  },
  "dependencies": {
    "@magi/bus": "*",
    "@magi/launcher": "*",
    "@magi/agent": "*",
    "@magi/providers": "*",
    "@magi/built-in-tools": "*",
    "@magi/contacts": "*",
    "@magi/memory": "*",
    "@magi/skills": "*",
    "@magi/webapp": "*",
    "@magi/channel-telegram": "*",
    "@tanstack/react-query": "^5.103.2",
    "dugite": "^3.2.3",
    "react": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "@magi/channel-a2a": "*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.5.0",
    "electron-builder": "^26.15.3",
    "node": "^24.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
