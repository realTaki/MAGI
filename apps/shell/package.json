{
  "name": "shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "description": "MAGI Electron shell. It prepares the environment and loads the app.",
  "allowScripts": {
    "dugite": true,
    "electron-winstaller": true,
    "node": true
  },
  "scripts": {
    "dev": "electron .",
    "build": "node scripts/prepare-runtime.mjs && electron-builder"
  },
  "build": {
    "appId": "ai.magi.app",
    "productName": "MAGI",
    "executableName": "MAGI",
    "files": [
      "main.mjs",
      "preload.cjs",
      "update-script.mjs",
      "boot/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/dugite/git/**"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "app": ".",
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "dugite": "^3.2.3"
  },
  "devDependencies": {
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "node": "^24.21.0"
  }
}
