{
  "name": "@local/magi-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MAGI Shell: Bot navigation and one persistent Main Bot using native DSH workspaces and conversations, with optional independent EVA nodes.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "main-session.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
