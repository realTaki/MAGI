{
  "name": "@magi/webapp",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "MAGI browser operator UI.",
  "main": "server.mjs",
  "files": [
    "dist/**",
    "localdb/**",
    "magi-asp/src/**",
    "server.mjs",
    "main.mjs"
  ],
  "exports": {
    "./localdb/app-store": "./localdb/app-store.mjs",
    "./localdb/asp-store": "./localdb/asp-store.mjs",
    "./server": "./server.mjs"
  },
  "scripts": {
    "dev": "vite",
    "start": "node main.mjs",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.cjs",
    "preview": "vite preview",
    "lint": "node scripts/i18n-lint.cjs",
    "lint:i18n": "node scripts/i18n-lint.cjs",
    "test": "node --test tests/*.test.mjs magi-asp/tests/*.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
